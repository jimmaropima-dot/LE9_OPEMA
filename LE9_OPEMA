#include <stdio.h>
#include <string.h>

int main() {
    FILE *fp;
    int n, age;
    char name[100], course[100], line[256];

    printf("Writing Student Database:\n");
    printf("How many students do you want to record? ");
    scanf("%d", &n);
    getchar();

    fp = fopen("student_records.txt", "w");

    for (int i = 1; i <= n; i++) {
        printf("\nStudent %d\n", i);

        printf("Enter Name: ");
        fgets(name, sizeof(name), stdin);
        name[strcspn(name, "\n")] = 0;

        printf("Enter Age: ");
        scanf("%d", &age);
        getchar();

        printf("Enter Course: ");
        fgets(course, sizeof(course), stdin);
        course[strcspn(course, "\n")] = 0;

        fprintf(fp, "Student %d\nName: %s\nAge: %d\nCourse: %s\n--------------------\n",
                i, name, age, course);
    }

    fclose(fp);
    printf("\nStudent database successfully saved to file.\n");

    fp = fopen("student_records.txt", "r");

    printf("\nReading Student Database:\n\n");
    while (fgets(line, sizeof(line), fp)) {
        printf("%s", line);
    }

    fclose(fp);
    return 0;
}
